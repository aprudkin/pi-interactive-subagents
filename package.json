{
  "name": "@aprudkin/pi-interactive-subagents",
  "version": "4.0.0",
  "description": "Maintained tmux-only interactive subagents for Pi",
  "repository": {
    "type": "git",
    "url": "https://github.com/aprudkin/pi-interactive-subagents.git"
  },
  "license": "MIT",
  "type": "module",
  "keywords": ["pi-package"],
  "engines": { "node": ">=22.19.0" },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 test/integration/*.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test && npm run test:integration"
  },
  "pi": {
    "extensions": ["./pi-extension/subagents/index.ts"]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@earendil-works/pi-tui": "0.85.1",
    "@types/node": "22.19.19",
    "typebox": "1.3.7",
    "typescript": "5.9.3"
  }
}
